# Shared Database Connection URL (same PostgreSQL connection as storefront)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret for Admin Authentication (should match or be unique to admin)
AUTH_SECRET="change-this-to-a-secure-random-32-char-string"

# Environment
NODE_ENV="production"

# Storefront URL for Cross-linking
NEXT_PUBLIC_STORE_URL="https://gaoessentialls.co.za"
